{
  "listen": {
    "host": "127.0.0.1",
    "port": 8443
  },
  "publicUrl": "https://minipc-a.example-tailnet.ts.net",
  "hostCallbackUrl": "https://minipc-a.example-tailnet.ts.net",
  "cloudCallbackUrl": "https://minipc-a.example-tailnet.ts.net",
  "tls": null,
  "dataDir": "~/.agent-hub",
  "adapters": {
    "claude": {
      "bin": "claude",
      "cloudBin": "claude"
    },
    "codex": {
      "bin": "codex",
      "cloudBin": "codex"
    },
    "gh": {
      "bin": "gh"
    }
  },
  "ssh": {
    "bin": "ssh",
    "identityFile": "~/.agent-hub/ssh/id_ed25519",
    "maxExecs": 4
  },
  "hosts": [
    {
      "id": "mini-1",
      "label": "mini-1",
      "target": "you@minipc-a",
      "color": "#43D1B0",
      "roots": [
        "~/code"
      ],
      "devices": [
        {
          "id": "stlink",
          "title": "ST-LINK V3SET",
          "kind": "Debug probe \u00b7 SWD",
          "icon": "SWD",
          "port": "/dev/ttyACM0",
          "probe": "test -e /dev/ttyACM0"
        },
        {
          "id": "pcan",
          "title": "PCAN-USB FD",
          "kind": "USB-CAN",
          "icon": "CAN",
          "port": "can0",
          "probe": "ip link show can0 | grep -q UP"
        }
      ],
      "hil": [
        {
          "id": "actuator-vv",
          "title": "Actuator V&V",
          "command": "./hil/run.sh",
          "cwd": "~/code/hexapod-robot",
          "devices": [
            "stlink",
            "pcan"
          ],
          "setup": [
            "mini-1",
            "PCAN-USB FD",
            "leg CAN bus",
            "ST-LINK"
          ]
        }
      ]
    },
    {
      "id": "mini-2",
      "label": "mini-2",
      "target": "you@minipc-b",
      "color": "#A6E15A",
      "roots": [
        "~/code"
      ]
    },
    {
      "id": "laptop",
      "label": "laptop (WSL2)",
      "target": "me@laptop-wsl",
      "color": "#6AA8FF",
      "roots": [
        "~/code"
      ]
    }
  ],
  "accounts": [
    {
      "id": "personal",
      "label": "Personal",
      "color": "#6AA8FF",
      "claude": {
        "configDir": "~/.claude-personal"
      },
      "codex": {
        "home": "~/.codex"
      },
      "git": {
        "name": "Personal",
        "email": "me@example.com"
      },
      "gh": {
        "configDir": "~/.agent-hub/profiles/personal/gh",
        "owners": [
          "your-github-user"
        ]
      },
      "hub": {
        "claudeConfigDir": "~/.agent-hub/profiles/personal/claude",
        "codexHome": "~/.agent-hub/profiles/personal/codex",
        "scratchDir": "~/.agent-hub/profiles/personal/scratch"
      },
      "cloud": {
        "claudeEnvironments": [
          {
            "id": "default",
            "label": "Default"
          }
        ],
        "codexEnvironments": [
          {
            "id": "env_hexapod",
            "label": "hexapod-ci"
          }
        ]
      }
    },
    {
      "id": "work",
      "label": "Work",
      "color": "#E0896B",
      "claude": {
        "configDir": "~/.claude-work"
      },
      "codex": {
        "home": "~/.codex-work"
      },
      "git": {
        "name": "Work",
        "email": "me@company.example"
      },
      "gh": {
        "configDir": "~/.agent-hub/profiles/work/gh",
        "owners": [
          "your-company-org"
        ]
      },
      "hub": {
        "claudeConfigDir": "~/.agent-hub/profiles/work/claude",
        "codexHome": "~/.agent-hub/profiles/work/codex",
        "scratchDir": "~/.agent-hub/profiles/work/scratch"
      },
      "cloud": {
        "claudeEnvironments": [
          {
            "id": "default",
            "label": "Default"
          }
        ],
        "codexEnvironments": [
          {
            "id": "env_work",
            "label": "work-ci"
          }
        ]
      }
    }
  ],
  "screenshot": {
    "chromiumPath": ""
  },
  "repoIndexIntervalSec": 60,
  "cloudPollIntervalSec": 30,
  "githubPollIntervalSec": 60,
  "metricsIntervalSec": 10,
  "claudeLivenessIntervalSec": 60,
  "retention": {
    "messagesDays": 30,
    "auditDays": 90,
    "approvalsDays": 7,
    "stateEndedDays": 7,
    "intervalMin": 60
  }
}